#!/bin/bash
# Runs OutFox and opens it again 10 s after it closes abruptly (crash).
# Before each start it waits for a real screen in its 60 Hz mode (display-watch --wait):
# with the TV off the HDMI port reports a generic 1024x768 screen, and a game started
# on it stays small once the TV is on. When display-watch sees the game running on
# another screen than the current one, it stops it and asks for a restart, which
# happens right away. Not restarted: a normal exit (code 0, e.g. Quit Game), a stop
# with outfox-stop (OutFox exits with 139 even on SIGTERM, so a plain pkill looks
# like a crash), or when another OutFox is already running by then (someone
# started it by hand, e.g. while debugging). After 5 crashes in 5 minutes it
# gives up, to avoid a crash loop. Log: ~/.cache/outfox-run.log
# started from a shell (over ssh, after outfox-stop): use the desktop session, as the autostart does
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" DISPLAY="${DISPLAY:-:0}" XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
OUTFOX="${OUTFOX:-$(ls -d "$HOME"/ProjectOutFox/OutFox-*/OutFox 2>/dev/null | head -1)}"
LOG="$HOME/.cache/outfox-run.log"
DELAY=10
STOP="$HOME/.cache/outfox-run.stop"
RESTART="$HOME/.cache/outfox-run.restart"
SCREEN="$HOME/.cache/outfox-run.screen"
mkdir -p "$(dirname "$LOG")"
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

crashes=()
rm -f "$STOP" "$RESTART"
while true; do
    "$HOME/.local/bin/display-watch" --wait >/dev/null 2>&1
    log "starting OutFox on: $(cat "$SCREEN" 2>/dev/null)"
    cd "$(dirname "$OUTFOX")" && "$OUTFOX" >/dev/null 2>&1
    code=$?
    if [ -f "$STOP" ]; then rm -f "$STOP" "$RESTART"; log "stopped with outfox-stop (code $code)"; break; fi
    if [ -f "$RESTART" ]; then rm -f "$RESTART"; log "restarting on the new screen"; continue; fi
    if [ $code -eq 0 ]; then log "normal exit"; break; fi
    now=$(date +%s)
    recent=()
    for t in "${crashes[@]}"; do [ $((now - t)) -lt 300 ] && recent+=("$t"); done
    crashes=("${recent[@]}" "$now")
    log "crashed (code $code), restarting in ${DELAY}s (${#crashes[@]} in the last 5 min)"
    if [ ${#crashes[@]} -ge 5 ]; then log "too many crashes, giving up"; break; fi
    sleep $DELAY
    if pgrep -x OutFox >/dev/null; then log "OutFox already running, not restarting"; break; fi
done
