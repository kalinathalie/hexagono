# best 60 Hz mode for whatever screen is connected, before the game starts
@HOME@/.local/bin/display-60hz >/dev/null 2>&1
# keeps the screen at 60 Hz and the game on it when screens change (a TV turned on later...)
@HOME@/.local/bin/display-watch >/dev/null 2>&1 &
# OutFox, once a screen is on, and again 10 s after a crash (stop it with outfox-stop)
@HOME@/.local/bin/outfox-run &
